OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=https://api.omni-route.com/v1
OMNIROUTE_MODEL=qwen2.5-7b-instruct
OMNIROUTE_TIMEOUT=60
OMNIROUTE_MAX_TOKENS=2048

MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=healthcare_system

SECRET_KEY=change_me_in_production_use_a_strong_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,txt

CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=INFO

# Phase 0: first admin seeding (used by scripts/seed_admin.py; never commit real values).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=System Administrator

# Phase 0: rate limiting budgets (slowapi).
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REGISTER=10/minute
RATE_LIMIT_UPLOAD=20/minute
RATE_LIMIT_CHAT=30/minute

# Phase 2: public verification links (QR codes point here) + reminders.
FRONTEND_URL=http://localhost:5173
NOTIFICATIONS_ENABLED=true
REMINDER_INTERVAL_HOURS=24

# Phase 2: optional SMTP (unset = in-app notifications only, nothing sent).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Phase 4: per-feature LLM model override (empty = OMNIROUTE_MODEL) + upload mode.
LLM_MODEL_INTERPRET=
LLM_MODEL_CHAT=
SYNC_UPLOAD=true
